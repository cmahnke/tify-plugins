{
  "name": "tify-plugins",
  "private": true,
  "version": "0.2.2",
  "description": "Demo app for the @projektemacher/tify-plugin-* IIIF viewer plugins",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:packages && vite build",
    "build:packages": "npm run build --workspace @projektemacher/tify-plugin-core && npm run build --workspace @projektemacher/tify-plugin-side-panel && npm run build --workspace @projektemacher/tify-plugin-image-overlays && npm run build --workspace @projektemacher/tify-plugin-hdr && npm run build --workspace @projektemacher/tify-plugin-c2pa && npm run build --workspace @projektemacher/tify-plugin-annotorious && npm run build --workspace @projektemacher/tify-plugin-musicxml",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node scripts/check-i18n.js . && npm run test:i18n --workspaces --if-present",
    "test:citation": "node scripts/ci-publish-guard.mjs --metadata",
    "test:e2e": "playwright test",
    "docs": "node scripts/build-docs.mjs dist/docs",
    "build:pages": "npm run build && npm run docs",
    "clean": "npm run clean --workspaces --if-present && rm -rf dist .tmp test-results playwright-report coverage *.tsbuildinfo",
    "lint": "eslint . && stylelint \"**/*.css\" && prettier . --check",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix && prettier . --write"
  },
  "dependencies": {
    "@projektemacher/tify-plugin-annotorious": "workspace:*",
    "@projektemacher/tify-plugin-c2pa": "workspace:*",
    "@projektemacher/tify-plugin-core": "workspace:*",
    "@projektemacher/tify-plugin-hdr": "workspace:*",
    "@projektemacher/tify-plugin-image-overlays": "workspace:*",
    "@projektemacher/tify-plugin-musicxml": "workspace:*",
    "@projektemacher/tify-plugin-side-panel": "workspace:*",
    "tify": "0.36.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.2",
    "marked-highlight": "^2.2.4",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=11"
  }
}
