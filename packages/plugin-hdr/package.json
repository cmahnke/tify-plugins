{
  "name": "@projektemacher/tify-plugin-hdr",
  "version": "0.2.2",
  "description": "HDR status panel plugin for the TIFY IIIF viewer",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://tify.rocks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmahnke/tify-plugins.git",
    "directory": "packages/plugin-hdr"
  },
  "keywords": [
    "iiif",
    "tify",
    "viewer",
    "plugin",
    "hdr"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node ../../scripts/check-i18n.js .",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check src example e2e package.json README.md"
  },
  "dependencies": {
    "@projektemacher/tify-plugin-core": "^0.2.0",
    "@projektemacher/hdr-canvas": "^0.4.0"
  },
  "peerDependencies": {
    "tify": "0.36.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=11"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
