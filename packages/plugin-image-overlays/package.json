{
  "name": "@projektemacher/tify-plugin-image-overlays",
  "version": "0.1.0",
  "description": "OpenSeadragon overlay markers plugin for the TIFY IIIF viewer",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://tify.rocks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmahnke/tify-plugins.git",
    "directory": "packages/plugin-image-overlays"
  },
  "keywords": [
    "iiif",
    "tify",
    "viewer",
    "plugin",
    "openseadragon",
    "overlay"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node ../../scripts/check-i18n.js .",
    "test:e2e": "playwright test",
    "test:tei": "node scripts/check-tei.mjs",
    "lint": "eslint . && prettier --check src example e2e scripts package.json README.md"
  },
  "dependencies": {
    "@projektemacher/tify-plugin-core": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "linkedom": "^0.18.13"
  },
  "peerDependencies": {
    "tify": "0.36.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
