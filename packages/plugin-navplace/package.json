{
  "name": "@projektemacher/tify-plugin-navplace",
  "version": "0.3.0",
  "description": "navPlace map plugin for the TIFY IIIF viewer: places from the manifest on a configurable vector-tile map (MapLibre, OpenFreeMap by default)",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://tify.rocks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmahnke/tify-plugins.git",
    "directory": "packages/plugin-navplace"
  },
  "keywords": [
    "iiif",
    "tify",
    "viewer",
    "plugin",
    "navplace",
    "map",
    "geojson",
    "maplibre",
    "vector-tiles",
    "openfreemap"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./navplace.css": "./dist/index.css"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test:i18n": "node ../../scripts/check-i18n.js .",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check src example e2e package.json README.md"
  },
  "dependencies": {
    "@projektemacher/tify-plugin-core": "^0.3.0",
    "maplibre-gl": "^6.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  },
  "peerDependencies": {
    "tify": "0.36.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=11"
  },
  "publishConfig": {
    "access": "public"
  }
}
